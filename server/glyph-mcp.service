# glyph-mcp: Claude's hosted MCP server for Glyph accounts (mcp/hosted.ts, docs/MCP.md), reached through glyph-api at
# ghostmarkdown.com/api/mcp (attack.fm stays a working alias).
#
# Installed by scripts/deploy-server.mjs beside glyph-api, which rewrites this file on every deploy - edit it here,
# not on the box. The same shape as glyph-api.service: the same system user, loopback only, the same hardening.
#
# It keeps one file, /var/lib/glyph-mcp/sessions.json, so that a restart signs nobody out: the sessions and their
# tokens, sealed so that the file opens nothing without a token Claude holds (mcp/hostedSeal.ts, and the header of
# mcp/hostedStore.ts). A signed-in person's account key is in this process's memory while their session is in use,
# and in that file only sealed. Nothing here to back up: the file is no use anywhere else, and losing it costs
# everyone one sign-in.

[Unit]
Description=Glyph MCP server (Claude's access to an account's notes, over glyph-api)
After=network-online.target glyph-api.service
Wants=network-online.target

[Service]
Environment=GLYPH_MCP_BIND=127.0.0.1:18820
Environment=GLYPH_MCP_ISSUER=https://ghostmarkdown.com/api/mcp
# The sync service on loopback, for this process; and as a person's browser reaches it, for the sign-in page.
Environment=GLYPH_API=http://127.0.0.1:8796/api
Environment=GLYPH_API_PUBLIC=https://ghostmarkdown.com/api
Environment=NODE_ENV=production
# The sessions, kept across a restart. systemd makes the directory, the service's own and nobody else's, and it is
# the one place ProtectSystem=strict leaves this process able to write.
StateDirectory=glyph-mcp
StateDirectoryMode=0700
Environment=GLYPH_MCP_STATE=/var/lib/glyph-mcp/sessions.json
ExecStart=/usr/bin/node /opt/glyph-api/mcp/glyph-mcp-hosted.mjs
User=glyph
Group=glyph
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# A session is one account's notes, opened, in memory. A hundred people signed in with a few hundred notes each fit
# well inside this; the ceiling is for a bug, not for the workload.
MemoryMax=384M

[Install]
WantedBy=multi-user.target
