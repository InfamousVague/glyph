# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
*.apk

# The Google Messages sidecar built for the phone (tool/build-gmsidecar.sh android): a build product.
/android/app/src/main/jniLibs/*/libgmsidecar.so
# The Signal helper and the C++ library it needs (tool/build-signalsidecar.sh android --ship), built for each release.
/android/app/src/main/jniLibs/*/libsignalsidecar.so
/android/app/src/main/jniLibs/*/libc++_shared.so
# The WhatsApp helper (tool/build-whatsappsidecar.sh android --ship), built for each release; and one built in its own folder.
/android/app/src/main/jniLibs/*/libwhatsappsidecar.so
/sidecar/whatsapp/whatsapp-sidecar
# The Matrix helper (tool/build-matrixsidecar.sh android --ship), built for each release; its other builds are in build/.
/android/app/src/main/jniLibs/*/libmatrixsidecar.so
