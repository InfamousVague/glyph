<?xml version="1.0" encoding="utf-8"?>
<!--
  HAND-EDITED AND TRACKED. `tauri android init` would regenerate this from its
  template and drop everything Glyph adds below, so .gitignore re-includes it
  by name. Every addition carries a comment saying what breaks without it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The microphone, for voice notes. The runtime prompt is raised by the
      generated RustWebChromeClient when the page first calls getUserMedia, which
      is also why MODIFY_AUDIO_SETTINGS is here: that client requests both, and a
      request for a permission the manifest does not declare is silently denied.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Over-the-air APK updates. Without it the installer intent that
      MainActivity.installApk sends is refused, and Settings never lists Glyph
      under "Install unknown apps" for the person to allow. The web layer
      updates without it; only a new native build needs the installer.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Update alerts, which are OFF unless the person turns them on in Settings.
      Android 13+ asks for this at that moment (MainActivity.setUpdateAlerts);
      without it the background check still runs but never shows anything.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Meetings (capture/MeetingService.kt, native generation 20): a recording
      that keeps going with the screen off, and the write-up that follows it
      with the app closed. A foreground service needs FOREGROUND_SERVICE, and
      from Android 14 each of its types needs its own permission and a
      matching type on the <service> below: MICROPHONE while it records (the
      only type Android lets hold a microphone in the background, and only when
      started while the app is in front), MEDIA_PROCESSING for the write-up on
      Android 15 and later, SPECIAL_USE for the same on Android 14, where that
      type does not exist yet. Without one of these the start throws and no
      meeting can be recorded. WAKE_LOCK keeps the CPU on while the phone is
      on the table with the screen off; without it the recording thread would
      stop with the screen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      The sound of other apps in a meeting, when "Include sound from other apps" is on (capture/OtherApps.kt,
      native generation 25): AudioPlaybackCapture runs on a MediaProjection, which Android 14 lets a service use only
      as a foreground service of type mediaProjection, and that type needs this permission. Asked for nowhere else:
      the consent is the screen-share dialog Android shows each time, and only when the switch is on. Calls are never
      in it (USAGE_VOICE_COMMUNICATION cannot be captured by any app).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      Where a note was written (Settings › Location, and a note's Add my location). Nothing asks for the
      position until the person taps one of those, or makes a new note with tagging on. The runtime prompt is
      raised by the generated RustWebChromeClient when the page first asks, and a request for a permission the
      manifest does not declare is silently denied. Both, so Android 12+ can offer Approximate.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      No Android TV: Tauri's template declared leanback and a TV launcher entry,
      and a store reviews an app that claims TV as a TV app (it has no banner, no
      remote navigation, and nothing to record on a TV).
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Nor does a note need a position to be written: a phone with no location hardware still lists the app. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      What Google's cloud backup takes (native generation 21). With no rules, Auto Backup takes everything under the
      data directory, and a film in a note (video/, src-tauri/src/videos.rs), which stays on the phone it was added on,
      would go to the person's Drive. So video/ is left out of the cloud, and meant to be kept in a move to a new phone
      by cable (not yet tried with Smart Switch). It does not keep the rest under Auto Backup's 25 MB quota, past which
      nothing of the app is backed up: a speech model in models/ (60 MB, or 190) is past it on its own, and a few long
      recordings can be. Whether notes should go to that backup at all is Matt's question (docs/DESIGN.md §141).
      dataExtractionRules is Android 12 and later; fullBackupContent is what Android 11 and earlier read.
      src-tauri/src/paths.rs reads both files.
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.glyph"
        android:fullBackupContent="@xml/glyph_backup_rules"
        android:dataExtractionRules="@xml/glyph_data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="${appLabel}"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The second way to qualify as an assistant, kept as a fallback for
              launchers and OEM builds that invoke the assistant by activity
              rather than through the voice interaction service. DEFAULT is not
              optional: the role controller matches with MATCH_DEFAULT_ONLY.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The capture action the side key and the launcher shortcut both send. -->
            <intent-filter>
                <action android:name="com.mattssoftware.glyph.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/glyph_shortcuts" />
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ghostmd" />
                
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <!--
          The digital assistant. Selecting Glyph under Settings > Apps > Default
          apps > Digital assistant app is what routes a held side key here. It is
          exported and guarded by BIND_VOICE_INTERACTION, which only the system
          holds, so no other app can bind it.
        -->
        <service
            android:name=".capture.GlyphInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/glyph_voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- One per press of the side key. Bound only by the system, so not exported. -->
        <service
            android:name=".capture.GlyphSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          A meeting being recorded, then written up (capture/MeetingService.kt).
          Not exported: only this app starts it, from MainActivity while in front
          and from its own notification's Stop and Discard. The types are the
          ones the service passes to startForeground as it goes: microphone while
          recording (with mediaProjection too when other apps' sound is in the
          meeting, native generation 25), then mediaProcessing (Android 15+) or specialUse (Android
          14) for the write-up. A type passed that is not declared here throws.
          The property is what specialUse asks for: a sentence saying what the
          special use is, which a store reviews.
        -->
        <service
            android:name=".capture.MeetingService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|mediaProcessing|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Writing up a meeting recording on the device" />
        </service>

        <!--
          WorkManager's own foreground service, given the write-up's types
          (recordings/RecordingWorker.kt calls setForegroundAsync with them on
          Android 14+). Merged onto the library's declaration, which has no
          type; without this the worker's foreground start throws
          InvalidForegroundServiceTypeException and the retry path runs with no
          notification at all.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Writing up a meeting recording on the device" />
        </service>

        <!-- Required by the assistant role and deliberately inert; see GlyphRecognitionService. -->
        <service
            android:name=".capture.GlyphRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/glyph_recognition" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- The notes' folder in the phone's Files app, read-only (files/LibraryDocuments.kt). -->
        <provider
          android:name=".files.LibraryDocuments"
          android:authorities="${applicationId}.library"
          android:exported="true"
          android:grantUriPermissions="true"
          android:permission="android.permission.MANAGE_DOCUMENTS">
          <intent-filter>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
          </intent-filter>
        </provider>
    </application>
</manifest>
