<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated iOS Info.plist by the Tauri build. Keys that must
  survive `tauri ios build` regenerating gen/apple/app_iOS/Info.plist live here.
-->
<plist version="1.0">
<dict>
	<!-- iOS 26+ TRAPS any app that never adopted the scene lifecycle
	     (EXC_BREAKPOINT in __UIApplicationEvaluateRuntimeIssueForNoScene-
	     LifecycleAdoption) - fatal on the iOS 27 runtime, a warning on 26.
	     SupportsMultipleScenes=true is the load-bearing key: tao keys
	     everything scene-shaped off multiple_scenes_enabled() and registers
	     its own scene delegate from code; the UISceneConfigurations block is
	     the documented fallback and harmless while the delegate method wins.
	     Learned the hard way in AttackFM; see its Info.ios.plist. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- The app's own links. ghostmd:// is the one the app answers today (a
	     shared note opening in the app: share/appLinks.ts, src/links.rs); the
	     deep-link plugin writes it at build time too, but REPLACES this key when
	     it does, so both are named here for whichever writes last. glyph:// is
	     kept for the voice-note shortcut the iOS capture work will answer. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mattssoftware.glyph</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ghostmd</string>
				<string>glyph</string>
			</array>
		</dict>
	</array>

	<!-- The microphone exists for one thing: recording a voice note, which is
	     turned into text ON THIS DEVICE. There is no cloud transcription. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Ghost.md uses the microphone while you record a voice note, and turns what you say into text on this device.</string>

	<!-- The name under the icon. project.yml's PRODUCT_NAME is still Glyph
	     (the ids stay glyph), so without this the home screen says Glyph. -->
	<key>CFBundleDisplayName</key>
	<string>Ghost.md</string>

	<!-- Export compliance. The app encrypts synced notes end to end (AES-GCM,
	     PBKDF2, Ed25519: src/app/core/sync/crypto.ts), besides HTTPS. On iOS
	     all of it is Apple's own implementation, WebCrypto in WKWebView (the
	     Rust crypto crates aren't built for iOS), which is the "encryption
	     limited to that within the Apple operating system" exemption, so false
	     is the right answer. Revisit if Rust crypto is ever built for iOS.
	     Declaring it stops App Store Connect asking at every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
</dict>
</plist>
