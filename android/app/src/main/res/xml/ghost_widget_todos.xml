<?xml version="1.0" encoding="utf-8"?>
<!-- To-dos (home/Widgets.kt, docs/WIDGETS_ANDROID.md): placed four cells by two; resized to a cell (how many are open, and
     overdue), a cell high (the first one), a column or four by four (as many as fit, in their groups).
     Drawn when the app hands something over and on its own clock, never on one of Android's. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/ghost_widget_todos_about"
    android:initialLayout="@layout/ghost_w_frame_system"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/ghost_w_preview_todos"
    android:previewImage="@drawable/ghost_w_preview_todos"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
