<?xml version="1.0" encoding="utf-8"?>
<!-- Recent notes (home/Widgets.kt, docs/WIDGETS_ANDROID.md): placed four cells by two; two cells by one at least (a row,
     the one written in last); a column, or large, and wide on the opened Fold in two columns. No cell alone: a list needs
     a row's width.
     Drawn when the app hands something over and on its own clock, never on one of Android's. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/ghost_widget_notes_about"
    android:initialLayout="@layout/ghost_w_frame_system"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/ghost_w_preview_notes"
    android:previewImage="@drawable/ghost_w_preview_notes"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
