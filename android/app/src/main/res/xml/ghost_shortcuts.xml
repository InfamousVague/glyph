<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press the icon for "Record note": the fallback for anyone who has not made the app the digital assistant, and
  the same capture action the side key sends, so both land in the same place. The package is this app's own id, not
  the Tauri app's.

  `android:enabled` is the word itself, as the Tauri app's is, and must be: Android reads a shortcut's `enabled` with its
  own resources, where an app's `@bool/…` is not a boolean at all, and reads that as false. It was
  `@bool/ghost_assistant` here, and so the shortcut was never on a phone, in any build. A build made without the
  assistant is given the other file instead (res/xml/ghost_no_shortcuts.xml), by the manifest's `${ghostShortcuts}`
  (android/app/build.gradle.kts).

  After it, the icon's own (ghost_app_shortcuts.xml says what each is), but Voice note, which Record note already is
  with the assistant on.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/ghost_capture_short"
        android:shortcutLongLabel="@string/ghost_capture_long">
        <intent
            android:action="com.mattssoftware.glyph.CAPTURE"
            android:targetPackage="com.mattssoftware.glyph.flutter"
            android:targetClass="com.mattssoftware.ghost_md.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new-note"
        android:enabled="true"
        android:icon="@drawable/ghost_shortcut_new"
        android:shortcutShortLabel="@string/ghost_shortcut_new_short"
        android:shortcutLongLabel="@string/ghost_shortcut_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ghostmd://new"
            android:targetPackage="com.mattssoftware.glyph.flutter"
            android:targetClass="com.mattssoftware.ghost_md.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ghost_shortcut_today"
        android:shortcutShortLabel="@string/ghost_shortcut_today_short"
        android:shortcutLongLabel="@string/ghost_shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ghostmd://today"
            android:targetPackage="com.mattssoftware.glyph.flutter"
            android:targetClass="com.mattssoftware.ghost_md.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ghost_shortcut_search"
        android:shortcutShortLabel="@string/ghost_shortcut_search_short"
        android:shortcutLongLabel="@string/ghost_shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ghostmd://search"
            android:targetPackage="com.mattssoftware.glyph.flutter"
            android:targetClass="com.mattssoftware.ghost_md.MainActivity" />
    </shortcut>
    <!-- Scan document: Google's document scanner, its pages kept as a new note's PDF (lib/files/plus_files.dart). -->
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ghost_shortcut_scan"
        android:shortcutShortLabel="@string/ghost_shortcut_scan_short"
        android:shortcutLongLabel="@string/ghost_shortcut_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ghostmd://scan"
            android:targetPackage="com.mattssoftware.glyph.flutter"
            android:targetClass="com.mattssoftware.ghost_md.MainActivity" />
    </shortcut>
</shortcuts>
