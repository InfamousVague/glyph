<?xml version="1.0" encoding="utf-8"?>
<!--
  Google's backup on Android 11 and earlier (AndroidManifest.xml, android:fullBackupContent). The notes go
  (Library/, their sidecars in Library/.glyph/notes/ and library.json with them); the library's index does not.
  It is SQLite in WAL mode, three files that change together and that a backup copies one at a time, and it is
  only a cache: the Rust core rebuilds it from the files the first time it opens (../glyph
  src-tauri/src/library/index.rs). `root` is the data directory, which lib/core/native/device_paths.dart opens
  the core on. index/ is where a chosen folder's index is kept (library/root.rs `INDEXES`).
-->
<full-backup-content>
    <exclude domain="root" path="Library/.glyph/index.sqlite" />
    <exclude domain="root" path="Library/.glyph/index.sqlite-wal" />
    <exclude domain="root" path="Library/.glyph/index.sqlite-shm" />
    <exclude domain="root" path="index/" />
</full-backup-content>
