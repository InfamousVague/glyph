<?xml version="1.0" encoding="utf-8"?>
<!--
  One to-do from Android 12: a real box (RemoteViews' compound buttons) drawn as the To-dos view's round tick, the red
  ring where it is overdue (the second box, shown in the first's place), then the words. 48dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="match_parent">

        <CheckBox
            android:id="@+id/ghost_w_check"
            style="@android:style/Widget.CompoundButton.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:button="@drawable/ghost_w_tick"
            android:contentDescription="@string/ghost_widget_tick"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <CheckBox
            android:id="@+id/ghost_w_check_late"
            style="@android:style/Widget.CompoundButton.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:button="@drawable/ghost_w_tick_overdue"
            android:contentDescription="@string/ghost_widget_tick"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/ghost_w_todo_words" />
</LinearLayout>
