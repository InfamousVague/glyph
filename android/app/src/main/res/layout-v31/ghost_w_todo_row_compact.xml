<?xml version="1.0" encoding="utf-8"?>
<!--
  One to-do on one line from Android 12, where a whole row does not fit under the last (home/WidgetViews.kt `todoRow`,
  compact): layout-v31/ghost_w_todo_row.xml's real box (the red ring where it is overdue), then its words alone. 36dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="match_parent">

        <CheckBox
            android:id="@+id/ghost_w_check"
            style="@android:style/Widget.CompoundButton.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:button="@drawable/ghost_w_tick"
            android:contentDescription="@string/ghost_widget_tick"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <CheckBox
            android:id="@+id/ghost_w_check_late"
            style="@android:style/Widget.CompoundButton.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:button="@drawable/ghost_w_tick_overdue"
            android:contentDescription="@string/ghost_widget_tick"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ghost_w_todo_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/ghost_w_press"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/ghost_w_todo_words"
            style="@style/GhostW.Words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" />
    </FrameLayout>
</LinearLayout>
