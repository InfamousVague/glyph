<?xml version="1.0" encoding="utf-8"?>
<!--
  Every widget's frame (home/WidgetViews.kt; docs/WIDGETS_ANDROID.md): the app's page with a card's hairline, a heading as the
  home page heads a section (a mark, the words, a count, and one round button at its end, the dock's `.round`), the
  rows that fit the widget's height in one column or two, a line for what did not fit, and the words for none.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_w_back"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/ghost_w_head"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/ghost_w_press"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ghost_w_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:tint="?attr/ghost_w_ink_3" />

        <!-- The words and the count in what the round button leaves: a narrow widget cuts them, never the button. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ghost_w_space_1"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ghost_w_title"
                style="@style/GhostW.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ghost_w_space_2" />

            <TextView
                android:id="@+id/ghost_w_count"
                style="@style/GhostW.Count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ghost_w_space_2"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/ghost_w_action"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ghost_w_ring">

            <ImageView
                android:id="@+id/ghost_w_action_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:tint="?attr/ghost_w_ink" />
        </FrameLayout>
    </LinearLayout>

    <!-- The rows, in what the heading leaves (Voice note's microphone in the middle of it); gone for the words for none. -->
    <LinearLayout
        android:id="@+id/ghost_w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ghost_w_col_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/ghost_w_col_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_4"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/ghost_w_more"
        style="@style/GhostW.When"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ghost_w_press"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ghost_w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/ghost_w_press"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/ghost_w_space_2"
        android:paddingEnd="@dimen/ghost_w_space_2"
        android:visibility="gone">

        <TextView
            android:id="@+id/ghost_w_empty_title"
            style="@style/GhostW.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/ghost_w_ink_2" />

        <TextView
            android:id="@+id/ghost_w_empty_words"
            style="@style/GhostW.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ghost_w_space_1"
            android:gravity="center"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
