<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows of Next up (Android 12+ draws a preview from a layout; older ones the picture of
     it): made-up event, in the widget's own look, in the app's own Dark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/GhostW.Theme.Dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_w_back"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_clock"
            android:tint="?attr/ghost_w_ink_3" />

        <TextView
            style="@style/GhostW.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="Next up" />

        <TextView
            style="@style/GhostW.Count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:layout_weight="1"
            android:text="" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ghost_w_ring">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_ic_plus"
                android:tint="?attr/ghost_w_ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="2dp">

        <TextView
            style="@style/GhostW.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In 25 min" />

        <TextView
            style="@style/GhostW.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="Dentist" />

        <TextView
            style="@style/GhostW.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="3:30 PM – 4:00 PM · Home" />
    </LinearLayout>
</LinearLayout>
