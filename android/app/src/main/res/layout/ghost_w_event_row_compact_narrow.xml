<?xml version="1.0" encoding="utf-8"?>
<!--
  An event, or a to-do due that day, on one line in a Calendar two cells across (2×N), where a whole row does not fit
  under the last: ghost_w_event_row_narrow.xml's mark, then when (the time it starts, All day, To-do, Overdue) and its
  words beside it rather than under. The ids are the wider row's; 36dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_w_event_row"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="@drawable/ghost_w_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <ImageView
        android:id="@+id/ghost_w_event_mark"
        android:layout_width="6.4dp"
        android:layout_height="6.4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ghost_w_event_ring" />

    <TextView
        android:id="@+id/ghost_w_event_time"
        style="@style/GhostW.Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ghost_w_space_2" />

    <TextView
        android:id="@+id/ghost_w_event_title"
        style="@style/GhostW.Words"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ghost_w_space_1"
        android:layout_weight="1" />
</LinearLayout>
