<?xml version="1.0" encoding="utf-8"?>
<!--
  One to-do on one line before Android 12, where a whole row does not fit under the last (home/WidgetViews.kt
  `todoRow`, compact): ghost_w_todo_row.xml's round tick to press, then its words alone. Android 12 and later draw
  layout-v31's, with a real box. 36dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/ghost_w_tick"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="@drawable/ghost_w_press"
        android:contentDescription="@string/ghost_widget_tick">

        <ImageView
            android:id="@+id/ghost_w_tick_ring"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ghost_w_tick_off" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ghost_w_todo_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/ghost_w_press"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/ghost_w_todo_words"
            style="@style/GhostW.Words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" />
    </FrameLayout>
</LinearLayout>
