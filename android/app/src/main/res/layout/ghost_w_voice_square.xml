<?xml version="1.0" encoding="utf-8"?>
<!--
  A microphone two cells across (2×N, home/WidgetViews.kt): Voice note's filled ring, or Ask AI's orange one, in the
  middle of the column and as big as it has room for (sized from Android 12), its words centred under it. The ring
  records at once (or listens, for Claude): nothing hears before that tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/ghost_w_voice_ring"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/ghost_w_ring_ink"
        android:contentDescription="@string/ghost_shortcut_voice_long">

        <ImageView
            android:id="@+id/ghost_w_voice_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ghost_w_ic_mic"
            android:tint="?attr/ghost_w_on_ink" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ghost_w_voice_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ghost_w_space_2"
        android:background="@drawable/ghost_w_press"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ghost_w_voice_title"
            style="@style/GhostW.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/ghost_w_voice_line"
            style="@style/GhostW.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
