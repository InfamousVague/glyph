<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows of Recent notes: made-up notes, in the widget's own look, in the app's own Dark (its theme unless chosen otherwise). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/GhostW.Theme.Dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_w_back"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_note"
            android:tint="?attr/ghost_w_ink_3" />

        <TextView
            style="@style/GhostW.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="Recent notes" />

        <TextView
            style="@style/GhostW.Count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:layout_weight="1"
            android:text="" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ghost_w_ring">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_ic_pen"
                android:tint="?attr/ghost_w_ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_note"
            android:tint="?attr/ghost_w_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/GhostW.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Groceries" />

            <TextView
                style="@style/GhostW.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Eggs, milk, the good bread" />
        </LinearLayout>

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:text="20 min ago" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_tape"
            android:tint="?attr/ghost_w_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/GhostW.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Standup" />

            <TextView
                style="@style/GhostW.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="4:12 · We went through the launch" />
        </LinearLayout>

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:text="2 hr ago" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_note"
            android:tint="?attr/ghost_w_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/GhostW.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trip to Lisbon" />

            <TextView
                style="@style/GhostW.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Flights on the 12th" />
        </LinearLayout>

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:text="Yesterday" />
    </LinearLayout>

</LinearLayout>
