<?xml version="1.0" encoding="utf-8"?>
<!--
  The Today and Pinned widgets' frame (home/TodayWidget.kt, home/PinnedWidget.kt): a heading with a count, the rows
  that fit the widget's height (each added by the widget's code), a line for what did not fit, and the words for
  none. The app's dark look: its paper, its hairline, its three inks.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_widget_back"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ghost_list_head"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@drawable/ghost_widget_press"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ghost_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/ghost_widget_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ghost_list_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/ghost_widget_ink_3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ghost_list_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/ghost_list_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:maxLines="1"
        android:textColor="@color/ghost_widget_ink_3"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ghost_list_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:textColor="@color/ghost_widget_ink_3"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
