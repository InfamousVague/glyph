<?xml version="1.0" encoding="utf-8"?>
<!-- A group's heading in a widget's rows (the To-dos view's `_GroupHeading`): the eyebrow, and how many. 22dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/ghost_w_eyebrow_words"
        style="@style/GhostW.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ghost_w_eyebrow_count"
        style="@style/GhostW.When"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ghost_w_space_2" />
</LinearLayout>
