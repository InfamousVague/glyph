<?xml version="1.0" encoding="utf-8"?>
<!--
  A note in a widget's rows (the home page's `HomeRow`): its kind's mark, its name, how it starts (a tape's length
  first), and when it was touched at the end. A tap opens it where it was left. 52dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_w_note_row"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/ghost_w_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <ImageView
        android:id="@+id/ghost_w_note_mark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:tint="?attr/ghost_w_ink_3" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ghost_w_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ghost_w_note_title"
            style="@style/GhostW.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/ghost_w_note_line"
            style="@style/GhostW.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ghost_w_note_when"
        style="@style/GhostW.When"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ghost_w_space_3" />
</LinearLayout>
