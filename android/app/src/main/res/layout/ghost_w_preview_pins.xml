<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows of Pinned notes (Android 12+ draws a preview from a layout; older ones the picture
     of it): made-up notes, in the widget's own look, in the app's own Dark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/GhostW.Theme.Dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_w_back"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_pin"
            android:tint="?attr/ghost_w_ink_3" />

        <TextView
            style="@style/GhostW.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="Pinned" />

        <TextView
            style="@style/GhostW.Count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:layout_weight="1"
            android:text="3" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ghost_w_ring">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_ic_pen"
                android:tint="?attr/ghost_w_ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_note"
            android:tint="?attr/ghost_w_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/GhostW.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Packing list" />

            <TextView
                style="@style/GhostW.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Passport, chargers, the blue jacket" />
        </LinearLayout>

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:text="Monday" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_book"
            android:tint="?attr/ghost_w_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/GhostW.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reading" />

            <TextView
                style="@style/GhostW.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The Overstory, then Piranesi" />
        </LinearLayout>

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_3"
            android:text="Oct 2" />
    </LinearLayout>
</LinearLayout>
