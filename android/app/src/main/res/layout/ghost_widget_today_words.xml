<?xml version="1.0" encoding="utf-8"?>
<!-- A to-do's words on the Today widget, and the note they are in under them: a tap opens the note at that line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_row_text"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/ghost_widget_press"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/ghost_row_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ghost_widget_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ghost_row_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ghost_widget_ink_3"
        android:textSize="12sp" />
</LinearLayout>
