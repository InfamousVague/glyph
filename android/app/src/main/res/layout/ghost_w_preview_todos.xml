<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows of To-dos: made-up to-dos, in the widget's own look, in the app's own Dark (its theme unless chosen otherwise). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/GhostW.Theme.Dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_w_back"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ghost_w_ic_todos"
            android:tint="?attr/ghost_w_ink_3" />

        <TextView
            style="@style/GhostW.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="To-dos" />

        <TextView
            style="@style/GhostW.Count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:layout_weight="1"
            android:text="3" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ghost_w_ring">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_ic_plus"
                android:tint="?attr/ghost_w_ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingBottom="3dp">

        <TextView
            style="@style/GhostW.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overdue" />

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_tick_late" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/GhostW.Words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send the report" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/GhostW.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ghost_w_space_2"
                    android:background="@drawable/ghost_w_chip_overdue"
                    android:drawableStart="@drawable/ghost_w_ic_due_overdue"
                    android:text="Yesterday"
                    android:textColor="?attr/ghost_w_red_11" />

                <TextView
                    style="@style/GhostW.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Work" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingBottom="3dp">

        <TextView
            style="@style/GhostW.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today" />

        <TextView
            style="@style/GhostW.When"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ghost_w_space_2"
            android:text="2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ghost_w_tick_off" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/GhostW.Words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call the plumber" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/GhostW.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ghost_w_space_2"
                    android:background="@drawable/ghost_w_chip_today"
                    android:drawableStart="@drawable/ghost_w_ic_due_today"
                    android:text="Today"
                    android:textColor="?attr/ghost_w_amber_11" />

                <TextView
                    style="@style/GhostW.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Errands" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
