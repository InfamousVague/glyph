<resources>
    <!-- the page: var(glacier-bg) -->
    <attr name="ghost_w_paper" format="color" />
    <color name="ghost_w_light_paper">#FFFDFDFD</color>
    <color name="ghost_w_dark_paper">#FF040404</color>
    <!-- a pressed row: the card's hover wash, 6% of the ink: color-mix(in oklch, var(app-ink) 6%, transparent) -->
    <attr name="ghost_w_press" format="color" />
    <color name="ghost_w_light_press">#0F0D0D0D</color>
    <color name="ghost_w_dark_press">#0FF3F3F3</color>
    <!-- a card's hairline: var(glacier-border-subtle) -->
    <attr name="ghost_w_rule" format="color" />
    <color name="ghost_w_light_rule">#FFE6E6E6</color>
    <color name="ghost_w_dark_rule">#FF171717</color>
