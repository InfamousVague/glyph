    <attr name="ghost_w_red_11" format="color" />
    <color name="ghost_w_light_red_11">#FFAC2F2F</color>
    <color name="ghost_w_dark_red_11">#FFFF9289</color>
    <!-- a day that is today, on its chip: var(glacier-amber-11) -->
    <attr name="ghost_w_amber_11" format="color" />
    <color name="ghost_w_light_amber_11">#FF8C5500</color>
    <color name="ghost_w_dark_amber_11">#FFEFB359</color>
