<?xml version="1.0" encoding="utf-8"?>
<!-- A press on a widget's button or row: a faint wash of the ink, the app's own pressed look. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26F3F3F3">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
