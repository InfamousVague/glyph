<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A model's download (native/src/models.rs) and the account's sync: the only things that leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Whether there is a connection at all, and the moment one comes back (Connection.kt): a blank left "Waiting
      for a connection" goes on then. A normal permission: nothing is asked of the person. The Tauri app has it
      too, merged in from WorkManager, which is what lets its WebView answer `navigator.onLine`.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The microphone, for dictation (capture/DictationMic.kt) and meetings. Asked for at the moment a person first
      records, never before; MODIFY_AUDIO_SETTINGS is for the noise suppression and gain control attached to it.
      NO ALWAYS-ON MICROPHONE: it is open only between a recording's start and its stop.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- "Written up" and the recording's own notification; Android 13+ asks at the meeting screen's prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Meetings (capture/MeetingService.kt, ported from tauri/): a recording that keeps going with the screen
      off, and the write-up that follows it with the app closed. A foreground service needs FOREGROUND_SERVICE,
      and from Android 14 each of its types needs its own permission and a matching type on the <service> below:
      MICROPHONE while it records (the only type Android lets hold a microphone in the background, and only when
      started while the app is in front), MEDIA_PROCESSING for the write-up on Android 15 and later, SPECIAL_USE
      for the same on Android 14, where that type does not exist yet. Without one of these the start throws and
      no meeting can be recorded. WAKE_LOCK keeps the CPU on while the phone is on the table with the screen off.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      The sound of other apps in a meeting, when "Include sound from other apps" is on (capture/OtherApps.kt):
      AudioPlaybackCapture runs on a MediaProjection, which Android 14 lets a service use only as a foreground
      service of type mediaProjection. Asked for nowhere else: the consent is the screen-share dialog Android shows
      each time, and only when the switch is on. Calls are never in it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      Where a note was written (Settings › Location, and a note's Add my location; Position.kt). Nothing asks for
      the position until the person taps one of those, or makes a new note with tagging on. Both, so Android 12+
      can offer Approximate.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Place reminders (ghost_md/reminders/Places.kt; docs/INTEGRATIONS.md §3): a to-do with a 📍 rings when the phone
      arrives there, through Play services' geofences, which ring with the app closed and so need the location all the
      time. Asked for only after the first place reminder is made, and only after the app has said why (its own sheet,
      then Android's "Allow all the time"); refused, the reminder is kept and its chip says it will not ring.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      A new version of the app, handed to Android's installer (UpdateInstaller.kt; lib/core/updates.dart). The
      person still allows it once, on Android's own page for this app, and confirms every install on its screen.
      Only a build told where its releases are ever asks (GHOST_UPDATES; tool/release.md).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Reminders for to-dos and tickets (ghost_md/reminders/Reminders.kt; docs/FEATURES_2_1.md). SCHEDULE_EXACT_ALARM
      lets an alarm ring on its minute once the person allows Alarms and reminders for the app (Android 12+; from 14
      a new install starts without it, and the alarm is then inexact, a few minutes late at most). Not
      USE_EXACT_ALARM, which Google Play keeps for alarm clocks and calendars. RECEIVE_BOOT_COMPLETED arms them again
      after a restart, which takes every alarm away (ReminderRestart): alarms only, no service is started.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Settings › Contacts (lib/integrations/contacts; docs/INTEGRATIONS.md §2): the phone's contacts read, for a person
      named on a to-do, once the person turns the switch on there, which is when Android asks. Read only, never
      written, and nothing of a contact leaves the phone. Opening a contact in the Contacts app needs no permission.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- A phone with no microphone still lists the app: notes can be typed. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Nor does a note need a position to be written: a phone with no location hardware still lists the app. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:label="${ghostLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/ghost_backup_rules"
        android:dataExtractionRules="@xml/ghost_data_extraction_rules">
        <!-- The backup rules keep the library's index (Library/.glyph/index.sqlite, a cache) out of a backup;
             the notes themselves go. res/xml/ghost_backup_rules.xml says why. -->
        <!-- ONE WINDOW, singleTask as Ghost.md's own activity is (docs/PARITY.md, Differs 1): a link, the side key,
             the launcher's shortcut or a notification's tap always reaches the one activity (onNewIntent) in the one
             task, wherever it was sent from. It was singleTop, which makes a second activity, and with it a second
             engine over the one core, when an intent arrives from another app's task without NEW_TASK. The empty
             taskAffinity is Flutter's own, kept: no other app's activity can be put into this task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- The launcher's entry, in every build but the one that replaces the Tauri app, whose launcher entry is
                 the alias below (android/app/build.gradle.kts, `ghostCutover`). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="${ghostOwnLauncher}"/>
            </intent-filter>
            <!--
              Links that open the app (AppLinks.kt; lib/share/app_links.dart says what each means): an invitation,
              `ghostmd://join/<code>`; something shared, `ghostmd://fork#<id>.<key>`, the reader page's "Open in the
              Ghost.md app"; a note, `ghostmd://note/<id>`, the tap on "written up"; and two places,
              `ghostmd://notifications` and `ghostmd://org/<id>`. The whole scheme, as the Tauri app's filter takes
              it, and BROWSABLE so a web page's link reaches it. The scheme is the real app's too: on a phone with
              both installed Android asks which one opens the link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS's ARC++ sends a link by another action; the Tauri app's filter took both. -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ghostmd" />
            </intent-filter>
            <!--
              Something shared from another app's share sheet (ShareIn.kt; lib/share/share_in.dart): text, a link, a
              picture or any file, one or several. The app's sheet asks whether it is a new note or goes onto one, and
              the person is back in the app they shared from when it is done.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!--
              A .ghostex opened from Files or a mail (ShareIn.kt; lib/export/ghostex_calls.dart): Settings › Import reads
              it back. Android has no type for one, so a file manager says application/octet-stream (or, for one
              that is not protected, a zip's type), and the filter asks for the name's ending too, so Ghost.md is not
              offered for every file of no known type. ShareIn.kt checks the name again before it keeps the file.
              The patterns are Android's way of matching a name with dots before its ending.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:pathSuffix=".ghostex" />
                <data android:pathPattern=".*\\.ghostex" />
                <data android:pathPattern=".*\\..*\\.ghostex" />
                <data android:pathPattern=".*\\..*\\..*\\.ghostex" />
            </intent-filter>
            <!--
              A link that opens the app is the app's own to follow (AppLinks.kt), never a route for Flutter to push:
              left on, the embedding hands each address to the framework, which put a second copy of the app over
              the first (lib/app/ghost_app.dart drops them too, for an entry point that forgets this).
            -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <!-- A long press of the icon: New note, Voice note, Today and Search (ghost_app_shortcuts.xml), with
                 "Record note" in Voice note's place in a build with the assistant (ghost_shortcuts.xml), and nothing
                 in a build made to be measured: the build says which, since a shortcut's own `enabled` cannot be
                 asked of a resource. The notes opened last follow, set while the app runs (home/HomeScreen.kt). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="${ghostShortcuts}" />
        </activity>

        <!--
          THE TAURI APP'S ACTIVITY, BY NAME, only in the build that replaces it (`@bool/ghost_cutover`;
          android/app/build.gradle.kts). A home screen keeps an app's icon, and a pinned "Record note", by the
          launcher activity's name, and removes them when an update no longer has an activity of that name. The
          Tauri app's was `com.mattssoftware.glyph.MainActivity`, so the update has one: an alias of this app's
          own, which is then the launcher's entry and the one the shortcuts hang on.
        -->
        <activity-alias
            android:name="com.mattssoftware.glyph.MainActivity"
            android:targetActivity=".MainActivity"
            android:enabled="@bool/ghost_cutover"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="${ghostTauriLauncher}"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="${ghostShortcuts}" />
        </activity-alias>

        <!--
          8F, THE PHONE ASSISTANT AND THE SIDE KEY: ported from tauri/ and DISABLED (`@bool/ghost_assistant`, false
          unless the build turns it on; android/app/build.gradle.kts says how), until a developer switches them on
          for one phone (AssistantSwitch.kt enables these four by name). Four things hang on the one switch: this
          alias, which is the activity's two capture doors (ASSIST for launchers and OEM builds that invoke the
          assistant by activity, and the capture action the side key and the launcher shortcut send; DEFAULT is not
          optional, the role controller matches with MATCH_DEFAULT_ONLY), and the three services below. Enabled,
          the app is OFFERED as a digital assistant and is not one until a person picks it in the phone's settings.
          Disabled, none of them exists as far as the system is concerned: the app is not offered and nothing can
          start a capture from outside it.
        -->
        <activity-alias
            android:name=".CaptureDoor"
            android:targetActivity=".MainActivity"
            android:enabled="@bool/ghost_assistant"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.mattssoftware.glyph.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
          The digital assistant. Selecting the app under Settings > Apps > Default apps > Digital assistant app is
          what routes a held side key here. Exported and guarded by BIND_VOICE_INTERACTION, which only the system
          holds, so no other app can bind it.
        -->
        <service
            android:name="com.mattssoftware.glyph.capture.GlyphInteractionService"
            android:enabled="@bool/ghost_assistant"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/ghost_voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- One per press of the side key. Bound only by the system, so not exported. -->
        <service
            android:name="com.mattssoftware.glyph.capture.GlyphSessionService"
            android:enabled="@bool/ghost_assistant"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the assistant role and deliberately inert; see GlyphRecognitionService. -->
        <service
            android:name="com.mattssoftware.glyph.capture.GlyphRecognitionService"
            android:enabled="@bool/ghost_assistant"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/ghost_recognition" />
        </service>

        <!--
          A meeting being recorded, then written up (capture/MeetingService.kt). Not exported: only this app starts
          it, from the activity while in front and from its own notification's Stop and Discard. The types are the
          ones the service passes to startForeground as it goes: microphone while recording (with mediaProjection
          too when other apps' sound is in the meeting), then mediaProcessing (Android 15+) or specialUse (Android
          14) for the write-up. A type passed that is not declared here throws. The property is what specialUse
          asks for: a sentence saying what the special use is, which a store reviews.
        -->
        <service
            android:name="com.mattssoftware.glyph.capture.MeetingService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|mediaProcessing|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Writing up a meeting recording on the device" />
        </service>

        <!--
          WorkManager's own foreground service, given the write-up's types (recordings/RecordingWorker.kt calls
          setForegroundAsync with them on Android 14+). Merged onto the library's declaration, which has no type;
          without this the worker's foreground start throws InvalidForegroundServiceTypeException and the retry
          path runs with no notification at all.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Writing up a meeting recording on the device" />
        </service>
        <!-- The verified APK of an update, read by Android's installer for the one intent that carries it
             (UpdateInstaller.kt): <cacheDir>/updates and nothing else (res/xml/ghost_update_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ghost_update_paths" />
        </provider>
        <!-- The reader of words in pictures (ML Kit's text recognition, Documents.kt), fetched by Google Play
             services with the app where the Play Store installs it, and the first time it is wanted otherwise. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <!-- A file in a note, handed to another app to open or share (Documents.kt): a copy under its own name in
             <cacheDir>/open and nothing else (res/xml/ghost_attachment_paths.xml), each grant for the one intent. -->
        <provider
            android:name=".AttachmentFiles"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ghost_attachment_paths" />
        </provider>
        <!-- The notes' folder in the phone's Files app, read-only (files/LibraryDocuments.kt, ported from tauri/).
             Exported and guarded by MANAGE_DOCUMENTS, which only the system's Files app holds. The authority is this
             app's own id's, as the Tauri app's is its own: on a phone with both, each lists its own place. -->
        <provider
            android:name="com.mattssoftware.glyph.files.LibraryDocuments"
            android:authorities="${applicationId}.library"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!--
          REMINDERS (ghost_md/reminders; docs/FEATURES_2_1.md). An alarm's moment and a notification's Done and
          Snooze 1 hour: not exported, reached only by this app's own PendingIntents. Then what takes the alarms
          away or moves the clock under them: a restart, this app updated, the time or the zone changed, Alarms and
          reminders allowed or taken back. Not exported either: the system's broadcasts still reach it, and nothing
          else can make it arm. Each arms the reminders again from what was kept; none starts a service.
        -->
        <receiver
            android:name=".reminders.ReminderAlarms"
            android:exported="false" />
        <!-- A place's geofence crossed: Play services' broadcast, through this app's own PendingIntent (Places.kt). -->
        <receiver
            android:name=".reminders.PlaceAlarms"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderRestart"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          THE HOME SCREEN (ghost_md/home; docs/FEATURES_2_1.md): Quick note, Today and Pinned notes, RemoteViews that
          draw what the app last handed over. Exported, as a widget's provider must be for the launcher to find it;
          only the system sends APPWIDGET_UPDATE. Today's own midnight comes to it as an alarm of this app's.
        -->
        <receiver
            android:name=".home.QuickNoteWidget"
            android:exported="true"
            android:label="@string/ghost_widget_quick_note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghost_widget_quick_note" />
        </receiver>
        <receiver
            android:name=".home.TodayWidget"
            android:exported="true"
            android:label="@string/ghost_widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghost_widget_today" />
        </receiver>
        <receiver
            android:name=".home.PinnedWidget"
            android:exported="true"
            android:label="@string/ghost_widget_pinned">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghost_widget_pinned" />
        </receiver>
        <!-- A to-do ticked on the Today widget: reached only by the widget's own PendingIntent. -->
        <receiver
            android:name=".home.WidgetTicks"
            android:exported="false" />
        <!-- New note, a tile in the notification shade's quick settings: bound only by the system. -->
        <service
            android:name=".home.NewNoteTile"
            android:exported="true"
            android:icon="@drawable/ghost_ic_tile"
            android:label="@string/ghost_tile_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
