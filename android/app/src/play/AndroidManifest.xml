<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play's build only (GHOST_STORE=play; android/app/build.gradle.kts `ghostPlay`, docs/store/play/README.md),
  laid over the release build's manifest. Play updates the app itself and refuses one that installs its own updates,
  so the two things in src/main that only the updater uses are taken out: the permission to hand an APK to Android's
  installer, and the FileProvider that hands it (UpdateInstaller.kt is still compiled, and never called: Dart's half,
  lib/core/updates.dart `playStoreBuild`, makes no updater).

  The location all the time is taken out too (Matt, 2026-11-05: Play's background location declaration not wanted).
  Without it no geofence registers, so place reminders ring only while the app is in front (reminders/Places.kt reads
  the manifest: the access is "whileOpen", "Allow all the time" is never asked, the places are watched in front), and
  the app says so instead of asking (lib/reminders/place_access.dart). The sideload APK keeps it.

  Foreground services: the microphone only (Matt, 2026-11-11, after Play's rejection of 2026-11-06 named the
  write-up's "Media Processing - Other" as deferrable; 2026-11-09 had kept it). Kept: MeetingService as `microphone`
  while a meeting the person started records. Taken out: media processing (the write-up their Stop starts is ordinary
  WorkManager work on every Android version, ForegroundTypes.writeUpType null), special use everywhere (FOREGROUND_SERVICE_SPECIAL_USE, every PROPERTY_SPECIAL_USE_FGS_SUBTYPE, the long-jobs
  service BackgroundJobService whole, so long jobs run while the app is open), media projection (other apps' sound
  in a meeting; the app hides its switch, lib/capture/meeting_host.dart), and WorkManager's foreground service's
  types (RecordingWorker never comes to the front: the write-up's retry and Android 14's write-up are ordinary
  work). The code reads what is declared here and never passes a type that is not (glyph/capture/ForegroundTypes.kt).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" tools:node="remove" />
    <application>
        <service
            android:name="com.mattssoftware.glyph.capture.MeetingService"
            android:foregroundServiceType="microphone"
            tools:replace="android:foregroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" tools:node="remove" />
        </service>
        <service
            android:name="com.mattssoftware.ghost_md.BackgroundJobService"
            tools:node="remove" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:remove="android:foregroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" tools:node="remove" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            tools:node="remove" />
    </application>
</manifest>
