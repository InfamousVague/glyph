<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- A debug build given GHOST_API reaches the account service run on this Mac (tool/local-server.sh) over plain
         http: 127.0.0.1, or 10.0.2.2 from the emulator. Only here: a release build has no cleartext traffic. -->
    <application android:usesCleartextTraffic="true">
        <!-- The widgets at every size, for their pictures (home/WidgetGallery.kt): debug builds only. Exported so adb's
             `am start` reaches it. -->
        <activity
            android:name="com.mattssoftware.ghost_md.home.WidgetGallery"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
