-                next_id = slice.ptr.redone;
+                // Yjs's `followRedone` carries `diff`: an id that falls inside a block is followed as far
+                // inside the block that one was put in again as, not to its start.
+                next_id = slice
+                    .ptr
+                    .redone
+                    .map(|redone| ID::new(redone.client, redone.clock + slice.start));
             } else {
                 break;
             }
