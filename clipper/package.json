{
  "name": "ghost-md-clipper",
  "private": true,
  "version": "0.1.0",
  "description": "Ghost.md's web clipper: a browser extension that saves a page into Ghost.md, sealed before it leaves the browser.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
