<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(GHOST_APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(GHOST_APP_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- The app's own links, as the real iPhone app claims them (tauri/src-tauri/Info.ios.plist): a shared
	     note, an invitation, "written up" (lib/share/app_links.dart). An iPhone with both apps hands a link to
	     whichever it chooses (README, "What the iPhone app left open"). `glyph://`, which the real app keeps for
	     a voice-note shortcut nothing answers yet, is not claimed. The real app claims no universal links (its
	     entitlements are empty and its deep-link plugin has `appLink` false), so neither does this. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ghostmd</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance: false, decided by Matt on 2026-10-13. What it says, in Apple's meaning of the key: the
	     app's encryption is exempt from providing export documentation. Not that it has none. It seals notes with
	     industry-standard algorithms in code it carries itself (the Rust core, native/src/crypto.rs: AES-256-GCM,
	     PBKDF2 and HKDF over SHA-256, ECDH on P-256, Ed25519), and its HTTPS is TLS from the Flutter engine's
	     BoringSSL. Nothing in it is proprietary, and the app is not sold in France (taken out of its availability
	     the same day). Why false and not true: a build that said true was refused by Apple at validation (error
	     90592, it wants the code Apple gives after reviewing export documentation); App Store Connect refused to
	     make a declaration for this case ("Cannot create appEncryptionDeclarations unless either
	     containsProprietaryCryptography is True or containsThirdPartyCryptography and availableOnFrenchStore are
	     both True"); and Apple's help page says an app that needs no documentation marks itself in its Info.plist
	     as one that "doesn't use encryption or is exempt from providing documentation". Apple also says such an
	     app "might" owe a yearly self-classification report to the U.S. government: Matt's to check. PUTTING
	     FRANCE BACK MEANS COMING BACK TO THIS: a French encryption declaration, a code, and true (and the EU
	     trader status France also waits on). docs/CUTOVER.md, section 8, "Export compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Adding a picture to a note offers Take Photo beside the photo library and the files, as the real iPhone
	     app's file input does (ios/Runner/GhostChannels.swift `PictureAsk`): the camera opens only for that, at
	     the person's tap. The words are the real app's. There is no microphone string: this app opens none on an
	     iPhone. -->
	<key>NSCameraUsageDescription</key>
	<string>Ghost.md uses the camera when you take a photo to add to a note.</string>
	<!-- Settings › Contacts (lib/integrations/contacts): asked when the person turns the switch on there, never
	     before. Read on the phone only. -->
	<key>NSContactsUsageDescription</key>
	<string>Ghost.md shows the picture of a person named on a to-do and lets you call, text or email them. Your contacts stay on this iPhone.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
